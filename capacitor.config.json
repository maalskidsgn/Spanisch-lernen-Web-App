{
  "appId": "de.habloo.app",
  "appName": "Habloo",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#faf7f1"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#faf7f1",
      "showSpinner": false
    }
  },
  "ios": {
    "backgroundColor": "#faf7f1",
    "limitsNavigationsToAppBoundDomains": false,
    "contentInset": "always"
  }
}
