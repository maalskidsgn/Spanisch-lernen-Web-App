node_modules/
dist/
.DS_Store
*.log

# Zugangsdaten – niemals ins Git!
# Alles ausschließen, dann eine Ausnahme: Die frühere Liste zählte die
# Dateien einzeln auf, und jede neue (.env.stationstest) rutschte
# durch. Bei einem öffentlichen Repo darf das nicht am Gedächtnis
# hängen. .env.example enthält nur leere Platzhalter und bleibt drin.
.env*
!.env.example

# Android: erzeugte Dateien und Schlüssel
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
*.keystore
*.jks

# iOS – Bauartefakte und persoenliche Xcode-Einstellungen
ios/App/build/
ios/App/Pods/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
ios/DerivedData/
*.xcuserstate

# Signaturschluessel – NIEMALS ins Repository
android/habloo-release.keystore
android/keystore.properties

# Hörproben fürs Casting – lokal, gehören nicht ins Repo
stimmen-proben/
hoerprobe.html
route-test.html

# Lesetexte liegen im Supabase-Speicher, nicht im öffentlichen Repo
public/lesetexte/
public/hoertexte/

# Store-Grafiken: gehören zum Projekt, die Bildschirmfotos aber nicht
# ins Repo – sie werden mit scripts/store-grafiken.mjs neu erzeugt.
