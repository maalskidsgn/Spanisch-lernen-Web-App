
# Spotify (optional) – für die Interpreten-Erkennung im Songs-Bereich.
# Anlegen auf developer.spotify.com/dashboard → "Create App".
# Als Redirect-URI eintragen: https://habloo.de/spotify
# Ein Client Secret wird NICHT gebraucht (wir nutzen PKCE).
VITE_SPOTIFY_CLIENT_ID=

# Stripe – Bezahlung. Anlegen unter dashboard.stripe.com
#   STRIPE_SECRET_KEY      Developers → API keys → Secret key (sk_...)
#   STRIPE_PREIS_ID        Product catalog → Produkt anlegen → Preis-ID (price_...)
#   STRIPE_WEBHOOK_SECRET  Developers → Webhooks → Endpunkt anlegen (whsec_...)
#                          Ziel: https://<dein-server>/api/bezahlung/melden
#                          Ereignisse: customer.subscription.created,
#                                      customer.subscription.updated,
#                                      customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_PREIS_ID=
STRIPE_WEBHOOK_SECRET=
